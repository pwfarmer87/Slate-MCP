{
  "name": "slate-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for connecting Technolutions Slate with Claude - enables student enrollment demographics reporting",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "slate-mcp-server": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "slate",
    "technolutions",
    "enrollment",
    "demographics",
    "higher-education",
    "claude"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
