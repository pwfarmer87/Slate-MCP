{
  "name": "slate-mcp-server",
  "version": "2.0.0",
  "description": "MCP server that gives Claude real-time, read-only enrollment pipeline data from Technolutions Slate query web services",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "slate-mcp-server": "./dist/index.js"
  },
  "files": [
    "dist",
    "config"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/e2e.test.ts",
    "check:slate": "tsx src/check.ts"
  },
  "keywords": [
    "mcp",
    "slate",
    "technolutions",
    "enrollment",
    "admissions",
    "higher-education",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
