# Slate service account: a Slate user added as a "Username" Web Service grantee
# on each query this server calls. Give it no other Slate permissions.
SLATE_USERNAME=svc-claude-mcp
SLATE_PASSWORD=

# Optional overrides
# SLATE_CONFIG=config/slate.config.json
# SLATE_PIPELINE_URL=https://apply.greenville.edu/manage/query/run?id=...&cmd=service&output=json&h=...
# SLATE_TIMEZONE=America/Chicago

# HTTP mode only (npm run start:http)
# MCP_AUTH_TOKEN=   # generate with: openssl rand -hex 32
# PORT=8787
# HOST=127.0.0.1
